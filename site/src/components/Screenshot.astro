---
// A screenshot of the UI, in the scheme the reader has picked: `<name>-dark.webp` and `<name>-light.webp` from
// src/assets/screenshots/, which scripts/screenshots.sh makes from synthetic data in a VM. A name ending in `-phone`
// is a phone's screen, shown narrow.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	caption?: string;
}

const { name, alt, caption } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.webp', { eager: true });
const image = (scheme: string) => {
	const file = files[`../assets/screenshots/${name}-${scheme}.webp`];
	if (!file) throw new Error(`no screenshot ${name}-${scheme}.webp (run mise run docs:screenshots)`);
	return file.default;
};
const phone = name.endsWith('-phone');
---

<figure class:list={['screenshot', { phone }]}>
	<Image src={image('dark')} alt={alt} class="light:sl-hidden" loading="lazy" />
	<Image src={image('light')} alt={alt} class="dark:sl-hidden" loading="lazy" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.screenshot {
		margin: 1.5rem 0;
	}
	/* No `display` here: Starlight's light:sl-hidden and dark:sl-hidden hide one of the two. */
	.screenshot :global(img) {
		vertical-align: top;
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
	}
	.phone {
		max-width: 20rem;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
