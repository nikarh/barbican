#!/bin/sh /etc/rc.common
# barbican-edge: applies the blocks of barbican agents (see /etc/config/barbican).
#
# Starts before the firewall (19) and the network (20). procd starts the daemon in the background, so the saved
# blocks are put in place first, synchronously (`restore`): they hold before the WAN is up.
START=11
STOP=89
USE_PROCD=1
PROG=/usr/sbin/barbican-edge

start_service() {
	config_load barbican
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	"$PROG" --config /etc/config/barbican restore

	procd_open_instance
	procd_set_param command "$PROG" --config /etc/config/barbican
	# Restart for as long as it takes: the blocks stay in place meanwhile.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param file /etc/config/barbican
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger barbican
}
