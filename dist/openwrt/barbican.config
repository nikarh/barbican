config barbican 'main'
	# 0: don't run.
	option enabled '1'
	# 1: follow the agents and save their state, but leave the firewall alone (status shows what it would block).
	option dry_run '0'
	option table 'barbican'
	# After connection tracking (-200), before NAT (-100).
	option priority '-190'
	# Also apply the agents' country blocks and blocking lists, not only their bans.
	option lists '1'
	# The last state, put back at boot (before any agent is reachable): saved when the agent stops cleanly (a
	# reboot, an upgrade). Flash wears: 0 saves only then, a number of seconds also that often.
	option state '/etc/barbican/state'
	option persist_interval '0'

# One section per barbican agent to follow: its [edge] listen address (https only), the fingerprint of its
# certificate (barbican edge-fingerprint on the agent prints it), and the token of a client configured there.
#config upstream 'server'
#	option url 'https://192.168.1.10:7380'
#	option fingerprint 'AB:CD:...'
#	option token_file '/etc/barbican/server.token'
