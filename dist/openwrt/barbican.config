config barbican 'main'
	# 0: don't run.
	option enabled '1'
	option table 'barbican'
	# After connection tracking (-200), before NAT (-100).
	option priority '-190'
	# Also apply the agents' country blocks and blocking lists, not only their bans.
	option lists '1'
	# The last state, put back at boot. Written when it changed, at most this often (seconds): flash wears.
	option state '/etc/barbican/state.json'
	option persist_interval '3600'

# One section per barbican agent to follow (its [edge] listen address, and the token of a client
# configured there).
#config upstream 'server'
#	option url 'http://192.168.1.10:7380'
#	option token_file '/etc/barbican/server.token'
